# Web 管理面板登录密码（部署前填写强密码）
PHDL_ADMIN_PASSWORD=

# Cookie 签名密钥（建议填 32 位以上随机字符串；留空时后端会自动生成并持久化到 data/.secret_key）
PHDL_SECRET_KEY=

# 宿主机监听地址和端口，供本机 OpenResty 反向代理
PHDL_BIND_IP=127.0.0.1
PHDL_PORT=8080

# 宿主机 rclone 配置目录（容器内挂载到 /root/.config/rclone）
RCLONE_CONFIG_PATH=./data/rclone

# 时区（影响每日定时追更时间）
TZ=Asia/Shanghai

# 如果通过 HTTPS 反向代理访问，建议设为 true 启用 Secure Cookie
PHDL_COOKIE_SECURE=false

# 如果通过独立域名反代且前后端 Origin 不同，可用逗号分隔配置允许来源
PHDL_ALLOWED_ORIGINS=

# 信任的反向代理网段（逗号分隔 CIDR；留空默认仅信任回环/Docker 网桥；直连公网/内网无前置反代且存在 Docker NAT 时可设为 none）
PHDL_TRUSTED_PROXIES=

# 是否开放 FastAPI 的 /docs 与 /openapi.json（默认关闭更安全）
PHDL_ENABLE_DOCS=false
